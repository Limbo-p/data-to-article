# ============================================================
# 环境变量模板：复制为 .env 后填写真实值（.env 已被 gitignore，绝不提交）
# ============================================================

# ---- 存储 ----
# 后端类型：mongo | file（file 无需任何外部服务）
DTA_STORAGE=file
# 仅 DTA_STORAGE=mongo 时需要
MONGO_URI=mongodb://localhost:27017
MONGO_DB=data_to_article

# ---- LLM（只填你用到的一个即可；mock 无需任何 key）----
DTA_LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
